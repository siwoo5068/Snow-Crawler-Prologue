  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JournalUI
  journalKey: 9
  journalPanel: {fileID: 503980548}
  paperImage: {fileID: 1604700394}
  journalText: {fileID: 681106817}
  pauseMenu: {fileID: 1744996352}
  journalContent: "[ \uC0DD\uC874 \uC77C\uC9C0 ]\n\n\u2460 \uBCC4\uC7A5 \uBC16\uC73C\uB85C
    \uB098\uAC00 \uAC00\uAD6C\uB97C \uCC3E\uC73C\uC138\uC694.\n   E\uD0A4 \u2014
    \uAC00\uAD6C \uC90D\uAE30\n\n\u2461 \uBB34\uAC70\uC6B8\uC218\uB85D \uC774\uB3D9\uC774
    \uB290\uB824\uC9D1\uB2C8\uB2E4.\n   G\uD0A4 \u2014 \uC544\uC774\uD15C \uB0B4\uB824\uB193\uAE30\n\n\u2462
    \uBCC4\uC7A5\uC73C\uB85C \uB3CC\uC544\uC640 \uAC00\uAD6C\uB97C \uBC30\uCE58\uD558\uC138\uC694.\n  
    Q\uD0A4 \u2014 \uAC00\uAD6C \uBC30\uCE58 \uBAA8\uB4DC\n   R\uD0A4 \u2014 \uBC30\uCE58
    \uC911 \uD68C\uC804\n\n\u2463 \uC791\uC5C5\uB300\uC5D0\uC11C \uCF54\uD2B8\uB97C
    \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uC138\uC694.\n   E\uD0A4 \u2014 \uC5C5\uADF8\uB808\uC774\uB4DC
    (\uC7AC\uB8CC 3\uAC1C \uD544\uC694)\n\n\u2464 \uCF54\uD2B8 Lv.2 \uC774\uC0C1
    + \uC548\uB77D\uB3C4 60% \uB2EC\uC131 \uC2DC\n   \uBB34\uC804\uAE30\uB97C \uC0AC\uC6A9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n[ Tab ] \uB2EB\uAE30"
